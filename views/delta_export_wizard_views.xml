<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delta_export_wizard_form" model="ir.ui.view">
        <field name="name">delta.export.wizard.form</field>
        <field name="model">delta.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Microinvest Delta - Export">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delta_export_wizard" model="ir.actions.act_window">
        <field name="name">Microinvest Delta Export</field>
        <field name="res_model">delta.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_delta_export_wizard"
              name="Microinvest Delta Export"
              action="action_delta_export_wizard"
              parent="account.menu_finance_receivables"
              groups="group_delta_export_user"
              sequence="90"/>
</odoo>
